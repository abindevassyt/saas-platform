# Multi-Stage Dockerfile for API Service

# Stage 1: Build stage
FROM node:20-alpine AS builder

WORKDIR /app

# Copy root and workspace definitions
COPY package.json tsconfig.json ./
COPY packages/database/package.json ./packages/database/
COPY apps/api/package.json ./apps/api/

RUN npm install

COPY packages/database ./packages/database
COPY apps/api ./apps/api

# Generate Prisma Client & Build TypeScript
RUN npm run db:generate --workspace=packages/database
RUN npm run build --workspace=packages/database
RUN npm run build --workspace=apps/api

# Stage 2: Production Minimal Stage
FROM node:20-alpine AS runner

WORKDIR /app

ENV NODE_ENV=production

# Security: Create non-root user
USER node

COPY --chown=node:node package.json ./
COPY --chown=node:node packages/database/package.json ./packages/database/
COPY --chown=node:node apps/api/package.json ./apps/api/

RUN npm install --only=production

COPY --chown=node:node --from=builder /app/packages/database/dist ./packages/database/dist
COPY --chown=node:node --from=builder /app/packages/database/prisma ./packages/database/prisma
COPY --chown=node:node --from=builder /app/apps/api/dist ./apps/api/dist

EXPOSE 4000

CMD ["node", "apps/api/dist/index.js"]
