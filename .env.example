# Node Environment
NODE_ENV=development
PORT=4000
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000

# Database (PostgreSQL with PgBouncer compatibility)
DATABASE_URL=postgresql://saas_user:secure_password_123@localhost:5432/saas_platform_db?schema=public&pgbouncer=true
DIRECT_URL=postgresql://saas_user:secure_password_123@localhost:5432/saas_platform_db?schema=public

# Cache & Pub/Sub (Redis)
REDIS_URL=redis://:redis_password_123@localhost:6379/0

# Authentication & Security
JWT_ACCESS_SECRET=super_secret_jwt_access_key_minimum_32_chars_long
JWT_REFRESH_SECRET=super_secret_jwt_refresh_key_minimum_32_chars_long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Cookie Configuration
COOKIE_SECRET=super_secret_cookie_signing_key_32_chars

# OAuth Credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# Stripe Payments Metadata
STRIPE_SECRET_KEY=sk_test_51MockKey...
STRIPE_WEBHOOK_SECRET=whsec_MockKey...

# Monitoring & Logging
LOG_LEVEL=info
PROMETHEUS_METRICS_ENABLED=true
